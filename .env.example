# Copy this file to .env and supply values from your own Supabase project.
# Never commit the resulting .env file.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_APP_API_URL=https://your-api.example.com

# Used only by local backend scripts and Supabase Edge Functions.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
APP_ORIGIN=https://your-app.example.com
